<Window x:Class="DepSweep.App.ImportProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DepSweep.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ImportProjectsViewModel}"
        Title="Import projects" Width="1000" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Assets/DepSweep.ico" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12">
            Pick one or more folders (or drop them here). DepSweep lists every npm/pnpm project inside them;
            check the ones you want and add them all at once.
        </TextBlock>

        <!-- Source folders -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding SourceFolders}" SelectedItem="{Binding SelectedSource}" Height="96"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Button Content="Add folders…" Command="{Binding AddSourcesCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                <Button Content="Paste paths" Command="{Binding PasteSourcesCommand}" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                        ToolTip="Add folder paths from the clipboard (one per line)" />
                <Button Content="Remove" Command="{Binding RemoveSourceCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- Candidates -->
        <DockPanel Grid.Row="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="Hide already included" IsChecked="{Binding HideIncluded}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Check all" Command="{Binding CheckVisibleCommand}" Margin="0,0,6,0" />
                    <Button Content="Uncheck all" Command="{Binding UncheckVisibleCommand}" />
                </StackPanel>
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                         ToolTip="Filter by name or path" />
            </DockPanel>
            <Grid>
                <DataGrid ItemsSource="{Binding CandidatesView}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                          SelectionMode="Extended" RowHeight="40" x:Name="CandidatesGrid" PreviewKeyDown="CandidatesGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="40" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Project" Width="2*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RelativePath}" Style="{StaticResource Muted}" FontSize="11" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PM" Binding="{Binding Manager}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="Repository" Binding="{Binding Repo}" Width="*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="already included" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Visibility="{Binding AlreadyIncluded, Converter={StaticResource BoolToVisibility}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>

        <!-- Mode -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <RadioButton Content="Add each checked project individually"
                         IsChecked="{Binding IsProjectsMode}" GroupName="Mode" />
            <RadioButton Content="Add the folders above as search folders (new projects inside them are picked up automatically)"
                         GroupName="Mode" Margin="0,4,0,0"
                         IsChecked="{Binding IsProjectsMode, Converter={StaticResource InvertBool}}" />
        </StackPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding AddButtonText}" Command="{Binding AcceptCommand}" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" MinWidth="140" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelDialogCommand}" IsCancel="True" MinWidth="90" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
