<Window x:Class="DepSweep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DepSweep.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}" Icon="Assets/DepSweep.ico"
        Width="1360" Height="840" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Command bar ===== -->
        <DockPanel Grid.Row="0" Margin="16,12,16,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/DepSweep.ico" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DepSweep" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Audit and fix npm / pnpm vulnerabilities across your repositories" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Allow --force (breaking)" IsChecked="{Binding Force}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="npm: npm audit fix --force (may apply semver-major upgrades). pnpm: pin patched versions with overrides." />
                <CheckBox Content="Include uncommitted" IsChecked="{Binding AllowDirty}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="Also fix projects whose package.json / lockfile already has uncommitted changes." />
                <Button Content="Discover" Command="{Binding DiscoverCommand}" Margin="0,0,8,0" MinWidth="90"
                        ToolTip="Search the folders on the left for projects" />
                <Button Content="Scan checked" Command="{Binding ScanCommand}" Margin="0,0,8,0" MinWidth="110"
                        ToolTip="Run npm/pnpm audit on the checked projects (read-only)" />
                <Button Content="Fix checked" Command="{Binding FixCommand}" Margin="0,0,8,0" MinWidth="110"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="Run audit fix on the checked projects, then show the report" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Folders pane -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Folders &amp; projects" Style="{StaticResource SectionHeader}" Margin="0,10,0,8" />

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Add folders…" Command="{Binding AddFoldersCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Pick one or more folders. A folder with a lockfile is added as a project; other folders are searched for projects." />
                    <Button Grid.Column="2" Content="Import…" Command="{Binding ImportProjectsCommand}" HorizontalAlignment="Stretch"
                            ToolTip="Browse one or more parent folders, review the projects found and add the ones you check" />
                    <Button Grid.Column="4" Content="Remove" Command="{Binding RemoveRootsCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=RootsList}"
                            ToolTip="Remove the highlighted entries (Ctrl/Shift-click to select several)" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox x:Name="RootsList" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"
                             SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="RootsList_KeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Enable" Command="{Binding EnableRootsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Disable" Command="{Binding DisableRootsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Search sub-folders" Command="{Binding SearchSubfoldersCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="This folder only" Command="{Binding ThisFolderOnlyCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Open in Explorer" Command="{Binding OpenRootFolderCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Remove" Command="{Binding RemoveRootsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RootViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                              ToolTip="Include this entry when discovering projects" />
                                    <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}" FontSize="11" ToolTip="{Binding Path}" />
                                        <TextBlock Text="Folder not found" Foreground="#D13B3B" FontSize="11"
                                                   Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Background="#332F7CD6" VerticalAlignment="Center"
                                            ToolTip="Search folder: sub-folders are searched for projects. Project: only this folder. Right-click to change.">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <Border BorderThickness="1" CornerRadius="8" Margin="12" Padding="16" VerticalAlignment="Center"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            Visibility="{Binding HasRoots, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Muted}">
                            Drop folders here, or use <Bold>Add folders…</Bold> to pick several at once.
                            <LineBreak /><LineBreak />
                            Use <Bold>Import…</Bold> to browse parent folders and choose which projects to add.
                        </TextBlock>
                    </Border>
                </Grid>

                <Expander Grid.Row="3" Margin="0,8,0,8" Header="Skipped folders" ToolTip="Folders with a package.json that cannot be audited">
                    <ListBox ItemsSource="{Binding IgnoredFolders}" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Reason}" FontSize="11" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Main tabs -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTab}">
                <!-- ===== Projects tab ===== -->
                <TabItem Header="Projects">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="160" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="230" MinHeight="100" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                     ToolTip="Filter by project name, path or branch" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding StatusFilter}"
                                      MinWidth="130" Margin="0,0,8,0" ToolTip="Show only projects in this state">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Grid.Column="2" Content="Group by repository" IsChecked="{Binding GroupByRepo}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Check all" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"
                                        ToolTip="Check every project currently shown" />
                                <Button Content="Uncheck all" Command="{Binding SelectNoneCommand}" Margin="0,0,6,0"
                                        ToolTip="Uncheck every project currently shown" />
                                <Button Content="Check vulnerable" Command="{Binding SelectVulnerableCommand}" />
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="ProjectsGrid" Grid.Row="1" ItemsSource="{Binding ProjectsView}" SelectedItem="{Binding SelectedProject}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                                  GridLinesVisibility="None" IsReadOnly="False" RowHeight="44"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  PreviewKeyDown="ProjectsGrid_PreviewKeyDown">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <Expander IsExpanded="True" Margin="0,4,0,0">
                                                            <Expander.Header>
                                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' · {0} project(s)'}" Foreground="Gray" />
                                                                </TextBlock>
                                                            </Expander.Header>
                                                            <ItemsPresenter />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Project" Width="2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayPath}" Style="{StaticResource Muted}" FontSize="11" ToolTip="{Binding Path}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="PM" Binding="{Binding Manager}" Width="55" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,3,8,0"
                                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Crit" Width="50" SortMemberPath="Critical">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource CriticalBrush}" VerticalAlignment="Center"
                                                    Opacity="{Binding Critical, Converter={StaticResource CountOpacity}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Critical, TargetNullValue='–'}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="High" Width="50" SortMemberPath="High">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource HighBrush}" VerticalAlignment="Center"
                                                    Opacity="{Binding High, Converter={StaticResource CountOpacity}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding High, TargetNullValue='–'}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Mod" Width="50" SortMemberPath="Moderate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource ModerateBrush}" VerticalAlignment="Center"
                                                    Opacity="{Binding Moderate, Converter={StaticResource CountOpacity}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Moderate, TargetNullValue='–'}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Low" Width="50" SortMemberPath="Low">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource LowBrush}" VerticalAlignment="Center"
                                                    Opacity="{Binding Low, Converter={StaticResource CountOpacity}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Low, TargetNullValue='–'}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Branch" Width="100" SortMemberPath="Branch">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Branch}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Repo}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Details" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Message}" Style="{StaticResource Muted}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Check highlighted" InputGestureText="Space" Command="{Binding CheckRowsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Uncheck highlighted" Command="{Binding UncheckRowsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Scan highlighted" Command="{Binding ScanRowsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Fix highlighted…" Command="{Binding FixRowsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Open folder" Command="{Binding OpenProjectFolderCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Copy path(s)" Command="{Binding CopyProjectPathsCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                        <!-- Details of the selected project -->
                        <Grid Grid.Row="3" DataContext="{Binding SelectedProject}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.ColumnSpan="3" Text="Select a project to see its vulnerabilities and output. Ctrl/Shift-click to highlight several; Space checks them; right-click for more."
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Converter={StaticResource NotNullToVisibility}, ConverterParameter=invert}" />

                            <DockPanel Grid.Column="0" Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                                    <Run Text="Vulnerabilities in" /> <Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                                <ListBox ItemsSource="{Binding Vulnerabilities}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}}">
                                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Severity}" FontSize="11" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Package, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="—" />
                                                        <Run Text="{Binding FixDescription, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Advisories}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" FontSize="11" Style="{StaticResource Muted}"
                                                                           ToolTip="{Binding Url}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <DockPanel Grid.Column="2" Visibility="{Binding Converter={StaticResource NotNullToVisibility}}">
                                <TextBlock DockPanel.Dock="Top" Text="Output" Style="{StaticResource SectionHeader}" />
                                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                                         FontSize="11" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         TextChanged="LogTextBox_TextChanged" />
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===== Report tab ===== -->
                <TabItem Header="Report">
                    <DockPanel Margin="0,8,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Copy as Markdown" Command="{Binding CopyReportCommand}" Margin="0,0,6,0" />
                                <Button Content="Export…" Command="{Binding ExportReportCommand}" Margin="0,0,6,0" />
                                <Button Content="Reports folder" Command="{Binding OpenReportsFolderCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        </DockPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReportRepos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RepoCardViewModel}">
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="Copy commit message" Command="{Binding CopyCommitMessageCommand}" Margin="0,0,6,0"
                                                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                                                        <Button Content="Copy git add" Command="{Binding CopyGitAddCommand}" Margin="0,0,6,0"
                                                                Visibility="{Binding GitAddCommand, Converter={StaticResource NotNullToVisibility}}" />
                                                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0" />
                                                        <Button Content="Terminal" Command="{Binding OpenTerminalCommand}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                Background="#332F7CD6"
                                                                Visibility="{Binding Branch, Converter={StaticResource NotNullToVisibility}}">
                                                            <TextBlock Text="{Binding Branch}" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
                                                        </Border>
                                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Background="#332E9E5B"
                                                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="changes to commit" FontSize="12" />
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding RepoRoot}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Summary}" Margin="0,6,0,8" />

                                                <ItemsControl ItemsSource="{Binding Projects}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="90" />
                                                                    <ColumnDefinition Width="220" />
                                                                    <ColumnDefinition Width="Auto" MinWidth="180" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                                                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}">
                                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                                    <Run Text="{Binding RelativePath, Mode=OneWay}" FontSize="11" Foreground="Gray" />
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2" Text="{Binding Counts}" FontFamily="Cascadia Mono, Consolas"
                                                                           Margin="0,0,16,0" ToolTip="Critical/High/Moderate/Low before → after" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Changed files" Style="{StaticResource SectionHeader}" />
                                                    <ItemsControl ItemsSource="{Binding ChangedFiles}" Margin="0,0,0,8">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" Foreground="#2E9E5B" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="Suggested commit message" Style="{StaticResource SectionHeader}" />
                                                    <TextBox Text="{Binding CommitMessage, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" />
                                                    <TextBox Text="{Binding GitAddCommand, Mode=OneWay}" IsReadOnly="True"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                                                             Visibility="{Binding GitAddCommand, Converter={StaticResource NotNullToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ===== Status bar ===== -->
        <DockPanel Grid.Row="2" Margin="16,8,16,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <ProgressBar DockPanel.Dock="Right" Width="160" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
